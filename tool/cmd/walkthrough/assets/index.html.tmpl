{{- /* Landing page listing every walkthrough. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Site.Title}}</title>
<link rel="stylesheet" href="style.css">
</head>
<body class="home">
<header class="top">
  <a class="brand" href="index.html">{{.Site.Title}}</a>
  <span class="sha" title="Code excerpts and links are pinned to this commit">
    <a href="https://github.com/{{.Site.Repo}}/tree/{{.Site.SHA}}" target="_blank" rel="noopener">{{short .Site.SHA}}</a>
  </span>
</header>
<main class="cards">
  <h1>Interactive walkthroughs of <a href="https://github.com/{{.Site.Repo}}">{{.Site.Repo}}</a></h1>
  <p class="summary">Step-by-step tours for specific questions. Code excerpts are extracted from the repository when the site is built, so they match commit <code>{{short .Site.SHA}}</code>.</p>
  {{- range .Site.Pages}}
  <a class="card" href="{{.Slug}}.html">
    <p class="eyebrow">{{.Audience}}</p>
    <h2>{{.Title}}</h2>
    <p>{{.Summary}}</p>
    <p class="meta">{{len .Steps}} steps · about {{minutes (len .Steps)}} minutes</p>
  </a>
  {{- end}}
  {{- if .Site.Static}}
  <h2 class="section">Related</h2>
  {{- range .Site.Static}}
  <a class="card small" href="{{.}}"><h2>{{title .}}</h2><p><code>{{.}}</code></p></a>
  {{- end}}
  {{- end}}
</main>
<footer class="foot">
  Generated by <code>go run ./tool/cmd/walkthrough</code> from
  <a href="https://github.com/{{.Site.Repo}}/tree/{{.Site.SHA}}/doc/walkthroughs" target="_blank" rel="noopener">doc/walkthroughs</a>.
</footer>
</body>
</html>
