{{- /* Walkthrough page: intro plus one step at a time, with a step list sidebar. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Page.Title}} · {{.Site.Title}}</title>
<link rel="stylesheet" href="style.css">
{{- if .Site.Token}}
<meta name="walkthrough-token" content="{{.Site.Token}}">
{{- end}}
{{- if .Site.Ask}}
<meta name="walkthrough-ask" content="1">
{{- end}}
<script>try{var t=localStorage.getItem("walkthrough.theme");if(t){document.documentElement.setAttribute("data-theme",t)}}catch(e){}</script>
</head>
<body data-steps="{{len .Page.Steps}}">
<div class="progress"><div class="bar" id="progress"></div></div>
<header class="top">
  <a class="brand" href="index.html">{{.Site.Title}}</a>
  <nav class="pages">
    {{- range .Site.Pages}}
    <a href="{{.Slug}}.html" title="{{.Title}}"{{if eq .Slug $.Page.Slug}} class="current"{{end}}>{{.NavTitle}}</a>
    {{- end}}
  </nav>
  <span class="sha" title="Code excerpts and links are pinned to this commit">
    <a href="https://github.com/{{.Site.Repo}}/tree/{{.Site.SHA}}" target="_blank" rel="noopener">{{short .Site.SHA}}</a>
  </span>
  <button type="button" class="theme" id="theme" aria-label="Toggle theme">☀</button>
</header>
<div class="layout">
  <aside class="steps">
    <p class="aside-title">Steps</p>
    <ol>
      <li><a href="#intro" data-step="0" class="step-link">Overview</a></li>
      {{- range .Page.Steps}}
      <li><a href="#{{.ID}}" data-step="{{.Index}}" class="step-link">{{.Title}}</a></li>
      {{- end}}
    </ol>
    <label class="toggle"><input type="checkbox" id="show-all"> Show all steps</label>
    <p class="hint">Use ← and → to move between steps.</p>
    <p class="source"><a href="https://github.com/{{.Site.Repo}}/blob/{{.Site.SHA}}/doc/walkthroughs/{{.Page.Slug}}.md" target="_blank" rel="noopener">Edit this walkthrough</a></p>
  </aside>
  <main>
    <section class="step intro" id="intro" data-step="0">
      <p class="eyebrow">{{.Page.Audience}}</p>
      <h1>{{.Page.Title}}</h1>
      <p class="summary">{{.Page.Summary}}</p>
      <div class="body">{{.Page.Intro}}</div>
    </section>
    {{- range .Page.Steps}}
    <section class="step" id="{{.ID}}" data-step="{{.Index}}">
      <p class="eyebrow">Step {{.Index}} of {{len $.Page.Steps}}</p>
      <h2>{{.Title}}</h2>
      {{- if or .Runs .Code}}
      <p class="badges">
        {{- if .Runs}}<span class="badge runs" title="Where this step runs"><b>Runs</b> {{.Runs}}</span>{{end}}
        {{- if .Code}}<span class="badge code" title="Whose code does the work"><b>Code</b> {{.Code}}</span>{{end}}
      </p>
      {{- end}}
      <div class="body">{{.Body}}</div>
      <details class="ask" data-page="{{$.Page.Title}}" data-step="{{.Title}}">
        <summary>Ask about this step</summary>
        <p class="hint">The question is sent with this page, step and the files it excerpts as context{{if not $.Site.Ask}}; without <code>-ask</code> it is copied to the clipboard for you to paste into any agent{{end}}.</p>
        <textarea rows="3" placeholder="e.g. Why does Java generate sequentially?"></textarea>
        <p class="ask-actions"><button type="button" class="ask-send">{{if $.Site.Ask}}Ask{{else}}Copy prompt{{end}}</button> <span class="ask-status"></span></p>
        <pre class="ask-answer" hidden></pre>
      </details>
    </section>
    {{- end}}
    <nav class="pager">
      <a id="prev" href="#intro">← Previous</a>
      <a id="next" href="#step-1">Next →</a>
    </nav>
  </main>
</div>
<footer class="foot">
  Generated by <code>go run ./tool/cmd/walkthrough</code> from
  <a href="https://github.com/{{.Site.Repo}}/tree/{{.Site.SHA}}/doc/walkthroughs" target="_blank" rel="noopener">doc/walkthroughs</a>
  at <code>{{short .Site.SHA}}</code>.
</footer>
<script src="app.js"></script>
</body>
</html>
