{{- range .Codec.BoilerPlate }}
//{{ . }}
{{- end }}

fn main() {
    #[cfg(feature = "_generate-protos")]
    {
        let root = std::env::var("SOURCE_ROOT")
            .expect("SOURCE_ROOT must be set");
        let includes: Vec<std::path::PathBuf> = std::env::split_paths(&root).collect();
        let destination = std::env::var("DEST")
            .expect("DEST must be set");
        let files = &[
            {{- range .Codec.Files }}
            "{{ . }}",
            {{- end }}
        ];
        let mut config = prost_build::Config::new();
        config.bytes(&["."]);
        config.disable_comments(&["."]);
        config.enable_type_names();
        config.type_name_domain(&["."], "type.googleapis.com");
        {{- /*
        Replicate prost_build's default well-known type mappings, except map
        BytesValue to bytes::Bytes to match wkt::BytesValue. See
        https://github.com/tokio-rs/prost/blob/13646cde7eab75c81b3047767aa0a86e7dbecf12/prost-build/src/extern_paths.rs#L39
        prost_path and prost_types_path are prost_build's defaults.
        */}}
        let prost_path = "::prost";
        let prost_types_path = "::prost_types";
        config.compile_well_known_types();
        config.extern_path(".google.protobuf", prost_types_path);
        config.extern_path(".google.protobuf.BoolValue", "bool");
        config.extern_path(".google.protobuf.BytesValue", format!("{prost_path}::bytes::Bytes"));
        config.extern_path(".google.protobuf.DoubleValue", "f64");
        config.extern_path(".google.protobuf.Empty", "()");
        config.extern_path(".google.protobuf.FloatValue", "f32");
        config.extern_path(".google.protobuf.Int32Value", "i32");
        config.extern_path(".google.protobuf.Int64Value", "i64");
        config.extern_path(".google.protobuf.StringValue", format!("{prost_path}::alloc::string::String"));
        config.extern_path(".google.protobuf.UInt32Value", "u32");
        config.extern_path(".google.protobuf.UInt64Value", "u64");
        {{- range .Codec.UnusedTypes }}
        config.extern_path("{{ . }}", "crate::prost::unused::NonexistentType");
        {{- end }}
        {{- with .Codec.IncludeFile }}
        config.include_file("{{ . }}");
        {{- end }}
        config.out_dir(&destination);
        config.compile_protos(files, &includes).expect("error compiling protos");
        {{- range .Codec.PostProcessProtos }}
        {{ . }}
        {{- end }}
    }
}
