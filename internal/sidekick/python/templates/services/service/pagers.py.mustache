class {{MethodNamePascal}}Pager:
    """A pager for iterating through ``{{MethodNameSnake}}`` requests.

    This class thinly wraps an initial
    :class:`{{ResponseDocType}}` object, and
    provides an ``__iter__`` method to iterate through its
    ``{{PageableItemField}}`` field.

    If there are more pages, the ``__iter__`` method will make additional
    ``{{MethodNamePascal}}`` requests and continue to iterate
    through the ``{{PageableItemField}}`` field on the
    corresponding responses.

    All the usual :class:`{{ResponseDocType}}`
    attributes are available on the pager. If multiple requests are made, only
    the most recent response is retained, and thus used for attribute lookup.
    """
    def __init__(self,
            method: Callable[..., {{ResponseType}}],
            request: {{RequestType}},
            response: {{ResponseType}},
            *,
            retry: OptionalRetry = gapic_v1.method.DEFAULT,
            timeout: Union[float, object] = gapic_v1.method.DEFAULT,
            metadata: Sequence[Tuple[str, Union[str, bytes]]] = ()):
        """Instantiate the pager.

        Args:
            method (Callable): The method that was originally called, and
                which instantiated this pager.
            request ({{RequestDocType}}):
                The initial request object.
            response ({{ResponseDocType}}):
                The initial response object.
            retry (google.api_core.retry.Retry): Designation of what errors,
                if any, should be retried.
            timeout (float): The timeout for this request.
            metadata (Sequence[Tuple[str, Union[str, bytes]]]): Key/value pairs which should be
                sent along with the request as metadata. Normally, each value must be of type `str`,
                but for metadata keys ending with the suffix `-bin`, the corresponding values must
                be of type `bytes`.
        """
        self._method = method
        self._request = {{RequestType}}(request)
        self._response = response
        self._retry = retry
        self._timeout = timeout
        self._metadata = metadata

    def __getattr__(self, name: str) -> Any:
        return getattr(self._response, name)

    @property
    def pages(self) -> Iterator[{{ResponseType}}]:
        yield self._response
        while self._response.{{NextPageTokenField}}:
            self._request.{{PageTokenField}} = self._response.{{NextPageTokenField}}
            self._response = self._method(self._request, retry=self._retry, timeout=self._timeout, metadata=self._metadata)
            yield self._response

    def __iter__(self) -> Iterator[{{ItemType}}]:
        for page in self.pages:
            yield from page.{{PageableItemField}}

    def __repr__(self) -> str:
        return '{0}<{1!r}>'.format(self.__class__.__name__, self._response)


class {{MethodNamePascal}}AsyncPager:
    """A pager for iterating through ``{{MethodNameSnake}}`` requests.

    This class thinly wraps an initial
    :class:`{{ResponseDocType}}` object, and
    provides an ``__aiter__`` method to iterate through its
    ``{{PageableItemField}}`` field.

    If there are more pages, the ``__aiter__`` method will make additional
    ``{{MethodNamePascal}}`` requests and continue to iterate
    through the ``{{PageableItemField}}`` field on the
    corresponding responses.

    All the usual :class:`{{ResponseDocType}}`
    attributes are available on the pager. If multiple requests are made, only
    the most recent response is retained, and thus used for attribute lookup.
    """
    def __init__(self,
            method: Callable[..., Awaitable[{{ResponseType}}]],
            request: {{RequestType}},
            response: {{ResponseType}},
            *,
            retry: OptionalAsyncRetry = gapic_v1.method.DEFAULT,
            timeout: Union[float, object] = gapic_v1.method.DEFAULT,
            metadata: Sequence[Tuple[str, Union[str, bytes]]] = ()):
        """Instantiates the pager.

        Args:
            method (Callable): The method that was originally called, and
                which instantiated this pager.
            request ({{RequestDocType}}):
                The initial request object.
            response ({{ResponseDocType}}):
                The initial response object.
            retry (google.api_core.retry.AsyncRetry): Designation of what errors,
                if any, should be retried.
            timeout (float): The timeout for this request.
            metadata (Sequence[Tuple[str, Union[str, bytes]]]): Key/value pairs which should be
                sent along with the request as metadata. Normally, each value must be of type `str`,
                but for metadata keys ending with the suffix `-bin`, the corresponding values must
                be of type `bytes`.
        """
        self._method = method
        self._request = {{RequestType}}(request)
        self._response = response
        self._retry = retry
        self._timeout = timeout
        self._metadata = metadata

    def __getattr__(self, name: str) -> Any:
        return getattr(self._response, name)

    @property
    async def pages(self) -> AsyncIterator[{{ResponseType}}]:
        yield self._response
        while self._response.{{NextPageTokenField}}:
            self._request.{{PageTokenField}} = self._response.{{NextPageTokenField}}
            self._response = await self._method(self._request, retry=self._retry, timeout=self._timeout, metadata=self._metadata)
            yield self._response
    def __aiter__(self) -> AsyncIterator[{{ItemType}}]:
        async def async_generator():
            async for page in self.pages:
                for response in page.{{PageableItemField}}:
